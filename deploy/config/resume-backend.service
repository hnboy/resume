[Unit]
Description=Resume Generator Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/resume-generator/backend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10

# 日志配置
StandardOutput=journal
StandardError=journal

# 安全配置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/resume-generator/backend/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
